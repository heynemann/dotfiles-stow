#!/bin/bash

# New tmux session in the current directory: two stacked shells on the left,
# nvim on the right (75%). Targets pane ids, so it works with any base-index.
path=$(pwd)

left=$(tmux new-session -d -c "$path" -P -F '#{pane_id}')
editor=$(tmux split-window -h -p 75 -t "$left" -c "$path" -P -F '#{pane_id}')
tmux split-window -v -p 50 -t "$left" -c "$path"

tmux send-keys -t "$editor" nvim Enter
tmux select-pane -t "$editor"

tmux attach-session -t "$editor"
