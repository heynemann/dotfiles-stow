# Run omarchy-restart-xcompose to apply changes

# Include fast emoji access
include "/usr/share/omarchy/default/xcompose"

# Identification
<Multi_key> <space> <n> : "Bernardo Heynemann"
<Multi_key> <space> <e> : "heynemann@gmail.com"

# US International, Windows-style dead keys (Portuguese + English).
# The locale table included above composes ' + c as ć and ' + s as ś, and turns
# any other unmatched ' or " sequence into ´X / ¨X. Override so ' + c gives ç,
# accents stay on vowels, and everything else types the quote plus the key
# (Let's, "Faça").
<dead_acute> <c> : "ç"
<dead_acute> <C> : "Ç"

# ' + key without an accent: apostrophe then the key
<dead_acute> <b> : "'b"
<dead_acute> <d> : "'d"
<dead_acute> <f> : "'f"
<dead_acute> <g> : "'g"
<dead_acute> <h> : "'h"
<dead_acute> <j> : "'j"
<dead_acute> <k> : "'k"
<dead_acute> <l> : "'l"
<dead_acute> <m> : "'m"
<dead_acute> <n> : "'n"
<dead_acute> <p> : "'p"
<dead_acute> <q> : "'q"
<dead_acute> <r> : "'r"
<dead_acute> <s> : "'s"
<dead_acute> <t> : "'t"
<dead_acute> <v> : "'v"
<dead_acute> <w> : "'w"
<dead_acute> <x> : "'x"
<dead_acute> <z> : "'z"
